<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SmokeTests.fs" />
    <!-- Phase 1896: the generic core at a NON-UI witness, and the boundary test
         that keeps the core UI-free. This project references the three core
         packages and no UI-tier package, so nothing UI-typed is in its graph. -->
    <Compile Include="ToyDomain.fs" />
    <Compile Include="GenericityTests.fs" />
    <!-- fuaran#2011: the toy witness as a specification subject. Its codec, the
         driver-semantics-toy family's shared runner (Fable-clean; the Fable
         parity leg and the proof host link these as source), the server-logic
         placement, the seeds, the .NET corpus IO, and the conformance leg. -->
    <Compile Include="ToyWire.fs" />
    <Compile Include="ToyScenarios.fs" />
    <Compile Include="ToyServerPlacement.fs" />
    <Compile Include="ToySeeds.fs" />
    <Compile Include="ToyCorpus.fs" />
    <Compile Include="ToyFamilyTests.fs" />
    <!-- Phase 1967: the SECOND witness — a verb over a file map, with an
         adversary per finding of the first second-domain instantiation. -->
    <Compile Include="VerbDomain.fs" />
    <Compile Include="VerbWitnessTests.fs" />
    <!-- Phase 1974: the THIRD witness — a document pipeline whose state is its
         tree, at a composition filling the state and walk axes. -->
    <Compile Include="DocDomain.fs" />
    <Compile Include="DocWitnessTests.fs" />
    <Compile Include="FlowTests.fs" />
    <Compile Include="FlowDecisionTests.fs" />
    <!-- Phase 1990: Each over a literal collection, on both axes. -->
    <Compile Include="EachTests.fs" />
    <!-- Phase 1991: Each over a collection the store holds, the dispatch axis -->
    <Compile Include="StoredEachTests.fs" />
    <!-- Phase 1992: the FOURTH witness — a grid of cells by identity, at the
         state axis, exercising Each against a spreadsheet's loops. -->
    <Compile Include="GridDomain.fs" />
    <Compile Include="GridWitnessTests.fs" />
    <Compile Include="HandlerDocumentTests.fs" />
    <Compile Include="AtMostTests.fs" />
    <!-- fuaran#2017: the proved staging, undo and effect gate as oracles at
         the toy witness, beside production. -->
    <Compile Include="ToyStagingOracleTests.fs" />
    <!-- fuaran#2017: the Phase 1980 durable replay differential, re-hosted at
         the toy witness. -->
    <Compile Include="ToyDurableReplayTests.fs" />
    <!-- fuaran#2017: the proof differentials at the toy witness, re-hosted
         from the UI-typed parity suite so the evidence stays when the UI
         adapters leave. -->
    <Compile Include="ToyBoundedFoldOracleTests.fs" />
    <Compile Include="ToyBudgetOracleTests.fs" />
    <Compile Include="ToyWireConformanceTests.fs" />
    <Compile Include="CoreBoundaryTests.fs" />
    <Compile Include="SchemaClockTests.fs" />
    <!-- fuaran#2012: the core's source guards and the demanded corpus's readings, re-homed
         here from the server suite that left with the UI adapters. -->
    <Compile Include="CoreSourceGuardTests.fs" />
    <Compile Include="DemandedCorpusReadTests.fs" />
    <Compile Include="WithdrawnCoverageTests.fs" />
    <!-- Phase 1905: the query evaluator seam (DECISIONS.md D34). -->
    <Compile Include="QueryEvaluatorTests.fs" />
    <Compile Include="StagedQueryPostureTests.fs" />
    <!-- Phase 2165 (D39): the durable tier's entry read, the op prefix, per-kind facets, composed contracts. -->
    <Compile Include="DurableInterpreterTests.fs" />
    <Compile Include="OpaqueLeafTests.fs" />
    <Compile Include="TypedReadTests.fs" />
    <Compile Include="ReceiptTests.fs" />
    <Compile Include="ReportTests.fs" />
    <!-- Phase 2220 (D47): the relation primitives and the derived view. -->
    <Compile Include="RelationTests.fs" />
    <Compile Include="DerivedViewTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fuaran.Program\Fuaran.Program.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Program.Bounded\Fuaran.Program.Bounded.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Program.Runtime\Fuaran.Program.Runtime.fsproj" />
    <ProjectReference Include="..\..\src\Fuaran.Program.Server\Fuaran.Program.Server.fsproj" />
    <!-- fuaran#2017: the extracted models (proofs/oracle), so the proof
         differential hosts run here, over the non-UI witnesses, rather than
         only through the UI tier. The oracle is FSharp.Core-only and is not
         packed; nothing UI-typed enters this graph through it. -->
    <ProjectReference Include="..\..\proofs\oracle\Fuaran.Program.Proofs.Oracle.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
  </ItemGroup>
</Project>
