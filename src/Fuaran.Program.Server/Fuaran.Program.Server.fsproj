<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Program.Server</PackageId>
    <Description>Fuaran.Program.Server — the server-logic placement of the bounded program loop: run a named, host-registered handler as data behind a program tree's call action, with a closed server-effect vocabulary (query, op-apply, host call, patch, notify) behind a default-deny gate. Shares the interpreter, the resource budget and the binding re-resolution pass with the other placements rather than reimplementing them. Carries the codec for the handler declared form, the effect vocabulary and the outcome report, certified against their own conformance corpus. Apache-2.0 licensed.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fuaran;program;bounded;server;handler</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ServerEffect.fs" />
    <Compile Include="Handler.fs" />
    <!-- ServerDemanded must precede ServerSession: the session's strict
         construction path consults the projection before it builds a session. -->
    <Compile Include="ServerDemanded.fs" />
    <Compile Include="ServerSession.fs" />
    <!-- The program wire's placement half: the handler declared form, the
         server-effect vocabulary and the outcome report, as documents. -->
    <Compile Include="HandlerWire.fs" />
    <!-- Replay must FOLLOW HandlerWire: the admission decision and the posture
         join both read the classification the wire half derives. It is also why
         the posture is joined onto the projection here rather than produced by
         the walk in ServerDemanded, which compiles earlier. -->
    <Compile Include="Replay.fs" />
    <!-- Undo (Phase 1977) sits beside Replay and after it: the undo posture is
         joined onto the projection on the replay posture's terms, and the undo
         run is a handler run, so it reads Handler and nothing above it. -->
    <Compile Include="Undo.fs" />
    <!-- Harvest must FOLLOW Replay and Undo: the published document carries
         both postures, so the one call that produces it consults the joins
         rather than reproducing a second walk beside them. -->
    <Compile Include="Harvest.fs" />
    <!-- The durable-execution tier, appended last so it can reach everything
         above it and nothing above it has to know it exists. Journal (the
         durability port) then Facets (what a placement guarantees, which is a
         function of the discipline) then Durable (the second interpreter, which
         reads both and calls Handler.run rather than reproducing it). -->
    <Compile Include="Journal.fs" />
    <Compile Include="Facets.fs" />
    <Compile Include="Durable.fs" />
    <!-- The denial detector, appended after the durable tier because it reaches
         BOTH of the things it joins: the effect registry's denial sink above,
         and the control vocabulary (and `ControlServices`) that the durable tier
         carries. Nothing above it consumes it — a host wires it onto its own
         registry before handing that registry to either interpreter — so last is
         where it costs the compile order nothing. -->
    <Compile Include="DenialDetector.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fuaran.Program.Bounded\Fuaran.Program.Bounded.fsproj" />
  </ItemGroup>
  <!-- fuaran#2461: the typed-read memo's hash count (`Reads.ContentHashes`) is
       internal evidence, read by the typed-read suite and by no host. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Fuaran.Program.Tests" />
  </ItemGroup>
  <!-- Domain-generic since Phase 1896 (DECISIONS.md D18): the handler loop,
       the server-effect vocabulary and its codecs are written over a domain's
       witness, and this package references NO UI-tier package — a test reads
       this file, its sources and the resolved graph to keep it that way. What
       it uses of the substrate it names directly: the JSON value and canonical
       form (Wire), the columnar table (Column), and the evaluator a server
       read runs (DataFrame). -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.Core.Wire" />
    <PackageReference Include="Fuaran.Core.Column" />
    <PackageReference Include="Fuaran.Compute.DataFrame" />
  </ItemGroup>
</Project>
